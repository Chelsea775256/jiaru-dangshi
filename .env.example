# ============================================================
#  环境变量配置样例（复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，绝不入库）
#  本项目所有密钥只通过环境变量注入，代码中不写任何明文密钥。
# ============================================================

# 知乎数据开放平台 Access Secret —— 用于实时拉取知乎热榜
# 获取：https://developer.zhihu.com/  ->  个人中心 -> Access Secret
ZHIHU_ACCESS_SECRET=

# 通义万相 / 阿里云百炼 API Key —— 用于实时生成场景线稿图（可选，缺省则用内置图库）
WANX_API_KEY=

# 豆包 / 火山方舟 LLM API Key —— 用于把知乎问题实时改编为互动剧本（可选，缺省则走预置剧本）
LLM_API_KEY=

# 可选：覆盖 LLM 接入点（默认火山方舟 ark 接口）
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_MODEL=doubao-seed-2-1-pro-260628

# 热榜预热开关：设为 1 才开启（会消耗 LLM 额度），默认 0 关闭
ZHIHU_HOT_WARMUP=0

# 服务端口（部署平台可用 PORT 覆盖）
PORT=4173
